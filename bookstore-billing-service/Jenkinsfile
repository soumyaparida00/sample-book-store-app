pipeline {
    agent any

    tools {
        jdk 'jdk11'
    }

    environment {
        AWS_REGION = "ap-south-1"
        IMAGE_NAME = "bookstore-billing-service"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Validate Branch') {
            steps {
                script {
                    def branch = env.BRANCH_NAME ?: (sh(script: "git rev-parse --abbrev-ref HEAD || echo release", returnStdout: true).trim())
                    if (!branch.contains('release')) {
                        error "This pipeline only builds the release branch. Detected: ${branch}"
                    }
                    echo "Building branch: ${branch}"
                }
            }
        }

        stage('Build Module') {
            steps {
                echo 'Skipping separate Maven build; Docker multi-stage build will compile the module.'
            }
        }

        stage('Build & Push Docker Image') {
            steps {
                sh '''
                    IMAGE_TAG=${IMAGE_TAG:-$(git rev-parse --short HEAD)}
                    AWS_REGION=${AWS_REGION:-us-east-1}
                    ECR_REGISTRY=${ECR_REGISTRY:-${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com}

                    # Ensure ECR repo exists (idempotent)
                    aws ecr describe-repositories --repository-names "$IMAGE_NAME" --region "$AWS_REGION" >/dev/null 2>&1 || \
                      aws ecr create-repository --repository-name "$IMAGE_NAME" --region "$AWS_REGION"

                    docker build -f bookstore-billing-service/Dockerfile -t "$IMAGE_NAME:$IMAGE_TAG" .

                    aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$ECR_REGISTRY"
                    docker tag "$IMAGE_NAME:$IMAGE_TAG" "$ECR_REGISTRY/$IMAGE_NAME:$IMAGE_TAG"
                    docker push "$ECR_REGISTRY/$IMAGE_NAME:$IMAGE_TAG"
                '''
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
