pipeline {
    agent any
    
    tools {
        jdk 'jdk11'
    }

    options {
        timestamps()
    }

    stages {

        stage('Checkout Source Code') {
            steps {
                script {
                    echo "Using existing workspace checkout..."
                    sh '''
                        CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD || echo release)
                        TARGET_BRANCH=${BRANCH_NAME:-${CURRENT_BRANCH:-release}}
                        git checkout "$TARGET_BRANCH"
                        git pull origin "$TARGET_BRANCH"
                    '''
                    echo "Repository ready on branch: ${env.BRANCH_NAME ?: 'release'}"
                }
            }
        }

        stage('Secret Scan (TruffleHog)') {
            steps {
                script {
                    echo "Running TruffleHog to scan for leaked secrets..."
                    sh '''
                        # Use containerized trufflehog to avoid local installs
                        docker run --rm -v "$PWD":/repo trufflesecurity/trufflehog:latest \
                          filesystem /repo \
                          --fail \
                          --only-verified
                    '''
                }
            }
        }

        stage('Security Audit (npm)') {
            steps {
                script {
                    echo "Running npm audit (production, high severity threshold)..."
                    sh '''
                        # Load frontend-specific env (includes CloudFront and API gateway URL placeholder)
                        if [ -f bookstore-frontend-react-app/dev.env ]; then . bookstore-frontend-react-app/dev.env; fi
                        cd bookstore-frontend-react-app
                        rm -rf node_modules package-lock.json
                        npm install --legacy-peer-deps
                        npm audit --production --audit-level=high
                    '''
                }
            }
        }

        stage('Build Frontend') {
            steps {
                script {
                    echo "Building React frontend..."
                    sh '''
                        # Load frontend-specific env (frontend dev.env contains the public API URL)
                        if [ -f bookstore-frontend-react-app/dev.env ]; then . bookstore-frontend-react-app/dev.env; fi
                        # Optional override for additional frontend settings (per-environment)
                        if [ -f bookstore-frontend-react-app/frontend.env ]; then . bookstore-frontend-react-app/frontend.env; fi
                        cd bookstore-frontend-react-app
                        rm -rf node_modules package-lock.json build

                        export NODE_OPTIONS=--openssl-legacy-provider
                        # Point the frontend to the deployed API gateway (prefer explicit frontend env URL over VM IP).
                        export REACT_APP_BACKEND_API_GATEWAY_URL="${FRONTEND_API_GATEWAY_URL:-${API_GATEWAY_URL:-${BACKEND_API_GATEWAY_URL:-http://$BACKEND_VM_IP:8765}}}"
                        npm install --legacy-peer-deps
                        npm run build
                    '''
                }
            }
        }

        stage('Deploy Frontend (S3 + CloudFront)') {
            steps {
                script {
                    echo "Deploying frontend to S3 and invalidating CloudFront cache..."
                    sh '''
                        if [ -f bookstore-frontend-react-app/dev.env ]; then . bookstore-frontend-react-app/dev.env; fi
                        if [ -f bookstore-frontend-react-app/frontend.env ]; then . bookstore-frontend-react-app/frontend.env; fi
                        FRONTEND_DIR="bookstore-frontend-react-app/build"

                        echo "Uploading build to S3 bucket: $S3_BUCKET"
                        aws s3 sync "$FRONTEND_DIR" "s3://$S3_BUCKET/" --delete --acl public-read

                        echo "Invalidating CloudFront cache for distribution: $CLOUDFRONT_DISTRIBUTION_ID"
                        aws cloudfront create-invalidation \
                            --distribution-id "$CLOUDFRONT_DISTRIBUTION_ID" \
                            --paths "/*"

                        echo "Frontend deployed successfully via CloudFront"
                    '''
                }
            }
        }

        stage('DAST (OWASP ZAP)') {
            steps {
                script {
                    echo "Running OWASP ZAP baseline scan against deployed site..."
                    sh '''
                        # Load frontend env for zap targets and S3/CF vars
                        if [ -f bookstore-frontend-react-app/dev.env ]; then . bookstore-frontend-react-app/dev.env; fi
                        mkdir -p zap
                        chmod -R 777 zap
                        # Use GHCR-hosted ZAP image (includes zap-baseline.py at /zap)
                        docker run --rm -t \
                          --user 0:0 \
                          -v "$PWD/zap":/zap/wrk \
                          ghcr.io/zaproxy/zaproxy:stable /zap/zap-baseline.py \
                          -t "https://$CLOUDFRONT_DOMAIN" \
                          -J zap-baseline.json \
                          -r zap-baseline.html \
                          -m 5 \
                          -I
                    '''
                    archiveArtifacts artifacts: 'zap/zap-baseline.*', allowEmptyArchive: true
                }
            }
        }
    }
    
    post {
        always {
            script {
                echo "Cleaning up workspace..."
                cleanWs()
            }
        }
    }
}
