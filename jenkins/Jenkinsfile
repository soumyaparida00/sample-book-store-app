pipeline {
    agent any
    
    tools {
        jdk 'jdk11'
    }

    environment {
        // Load variables
        ENV_FILE = "jenkins/env/dev.env"
    }

    options {
        timestamps()
    }

    stages {

        stage('Checkout Source Code') {
            steps {
                script {
                    echo "Using existing workspace checkout..."
                    sh '''
                        git checkout main || git checkout master
                        git pull origin main || git pull origin master
                    '''
                    echo "Repository ready"
                }
            }
        }

        stage('Build Frontend') {
            steps {
                script {
                    echo "Building React frontend..."
                    sh '''
                        cd bookstore-frontend-react-app
                        rm -rf node_modules package-lock.json build

                        export NODE_OPTIONS=--openssl-legacy-provider
                        npm install --legacy-peer-deps
                        npm run build
                    '''
                }
            }
        }

        stage('Deploy Frontend (S3 + CloudFront)') {
            steps {
                script {
                    echo "Deploying frontend to S3 and invalidating CloudFront cache..."
                    sh '''
                        . jenkins/env/dev.env
                        FRONTEND_DIR="bookstore-frontend-react-app/build"

                        echo "Uploading build to S3 bucket: $S3_BUCKET"
                        aws s3 sync "$FRONTEND_DIR" "s3://$S3_BUCKET/" --delete --acl public-read

                        echo "Invalidating CloudFront cache for distribution: $CLOUDFRONT_DISTRIBUTION_ID"
                        aws cloudfront create-invalidation \
                            --distribution-id "$CLOUDFRONT_DISTRIBUTION_ID" \
                            --paths "/*"

                        echo "Frontend deployed successfully via CloudFront"
                    '''
                }
            }
        }

        stage('Build Backend') {
            steps {
                script {
                    echo "Building Spring Boot backend services..."
                    sh '''
                        # Build the Maven reactor once so parent and shared modules are installed locally
                        mvn -B -DskipTests clean install

                        # Collect deployable JARs for the services we ship
                        cp bookstore-api-gateway-service/target/bookstore-api-gateway-service-0.0.1-SNAPSHOT.jar bookstore-api-gateway.jar
                        cp bookstore-catalog-service/target/bookstore-catalog-service-0.0.1-SNAPSHOT.jar bookstore-catalog.jar
                    '''
                }
            }
        }

        stage('Provision Backend Services (VM)') {
            steps {
                script {
                    echo "Ensuring backend systemd services exist..."
                    sh '''
                        . jenkins/env/dev.env

                        ssh ubuntu@$BACKEND_VM_IP <<EOF
                        set -e
                        BACKEND_DEPLOY_PATH="$BACKEND_DEPLOY_PATH"

                        sudo mkdir -p "$BACKEND_DEPLOY_PATH"
                        sudo chown ubuntu:ubuntu "$BACKEND_DEPLOY_PATH"

                        sudo tee /etc/systemd/system/bookstore-backend.service > /dev/null <<UNIT
[Unit]
Description=Bookstore API Gateway
After=network.target

[Service]
User=ubuntu
WorkingDirectory=$BACKEND_DEPLOY_PATH
ExecStart=/usr/bin/java -jar bookstore-api-gateway.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
UNIT

                        sudo tee /etc/systemd/system/bookstore-catalog.service > /dev/null <<UNIT
[Unit]
Description=Bookstore Catalog Service
After=network.target

[Service]
User=ubuntu
WorkingDirectory=$BACKEND_DEPLOY_PATH
Environment=SERVER_PORT=6001
ExecStart=/usr/bin/java -jar bookstore-catalog.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
UNIT

                        sudo systemctl daemon-reload
                        sudo systemctl enable bookstore-backend.service
                        sudo systemctl enable bookstore-catalog.service
EOF
                    '''
                }
            }
        }

        stage('Deploy Backend (VM)') {
            steps {
                script {
                    echo "Deploying backend JARs to VM..."
                    sh '''
                        . jenkins/env/dev.env
                        scp bookstore-api-gateway.jar ubuntu@$BACKEND_VM_IP:$BACKEND_DEPLOY_PATH/
                        scp bookstore-catalog.jar ubuntu@$BACKEND_VM_IP:$BACKEND_DEPLOY_PATH/

                        ssh ubuntu@$BACKEND_VM_IP <<EOF
                            sudo systemctl restart bookstore-backend.service
                            sudo systemctl restart bookstore-catalog.service
EOF

                        echo "Backend deployed successfully"
                    '''
                }
            }
        }

        stage('Install & Configure Nginx (VM)') {
            steps {
                script {
                    echo "Installing and configuring Nginx reverse proxy..."
                    sh '''
                        . jenkins/env/dev.env

                        ssh ubuntu@$BACKEND_VM_IP <<'EOF'
                        set -e
                        if ! command -v nginx >/dev/null 2>&1; then
                            sudo apt-get update -y
                            sudo DEBIAN_FRONTEND=noninteractive apt-get install -y nginx
                        fi

                        sudo tee /etc/nginx/sites-available/bookstore > /dev/null <<'NGINX'
server {
    listen 80;
    server_name _;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
NGINX

                        sudo ln -sf /etc/nginx/sites-available/bookstore /etc/nginx/sites-enabled/bookstore
                        sudo rm -f /etc/nginx/sites-enabled/default
                        sudo nginx -t
                        sudo systemctl enable nginx
                        sudo systemctl restart nginx
EOF
                    '''
                }
            }
        }

        stage('Smoke Test') {
            steps {
                script {
                    echo "Running smoke tests..."
                    sh '''
                        . jenkins/env/dev.env
                        echo "Checking backend API health..."
                        curl -f "http://$BACKEND_VM_IP:8080/actuator/health"

                        echo "Checking frontend CDN availability..."
                        curl -I "https://$CLOUDFRONT_DOMAIN" | grep HTTP

                        echo "Smoke tests passed successfully"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "CI/CD pipeline executed successfully!"
        }
        failure {
            echo "Pipeline failed. Check logs for details."
        }
    }
}
