pipeline {
    agent any
    
    tools {
        jdk 'jdk11'
    }

    environment {
        // Load variables
        ENV_FILE = "jenkins/env/dev.env"
    }

    options {
        timestamps()
    }

    stages {

        stage('Checkout Source Code') {
            steps {
                script {
                    echo "Using existing workspace checkout..."
                    sh '''
                        git checkout main || git checkout master
                        git pull origin main || git pull origin master
                    '''
                    echo "Repository ready"
                }
            }
        }

        stage('Build Frontend') {
            steps {
                script {
                    echo "Building React frontend..."
                    sh '''
                        cd bookstore-frontend-react-app
                        rm -rf node_modules package-lock.json build

                        export NODE_OPTIONS=--openssl-legacy-provider
                        npm install --legacy-peer-deps
                        npm run build
                    '''
                }
            }
        }

        stage('Deploy Frontend (S3 + CloudFront)') {
            steps {
                script {
                    echo "Deploying frontend to S3 and invalidating CloudFront cache..."
                    sh '''
                        . jenkins/env/dev.env
                        FRONTEND_DIR="bookstore-frontend-react-app/build"

                        echo "Uploading build to S3 bucket: $S3_BUCKET"
                        aws s3 sync "$FRONTEND_DIR" "s3://$S3_BUCKET/" --delete --acl public-read

                        echo "Invalidating CloudFront cache for distribution: $CLOUDFRONT_DISTRIBUTION_ID"
                        aws cloudfront create-invalidation \
                            --distribution-id "$CLOUDFRONT_DISTRIBUTION_ID" \
                            --paths "/*"

                        echo "Frontend deployed successfully via CloudFront"
                    '''
                }
            }
        }

        stage('Build Backend') {
            steps {
                script {
                    echo "Building Spring Boot backend services..."
                    sh '''
                        # Build the Maven reactor once so parent and shared modules are installed locally
                        mvn -B -DskipTests clean install

                        # Collect deployable JARs for the services we ship
                        cp bookstore-api-gateway-service/target/bookstore-api-gateway-service-0.0.1-SNAPSHOT.jar bookstore-api-gateway.jar
                        cp bookstore-catalog-service/target/bookstore-catalog-service-0.0.1-SNAPSHOT.jar bookstore-catalog.jar
                    '''
                }
            }
        }

        stage('Deploy Backend (VM)') {
            steps {
                script {
                    echo "Deploying backend JARs to VM..."
                    sh '''
                        . jenkins/env/dev.env
                        scp bookstore-api-gateway.jar ubuntu@$BACKEND_VM_IP:$BACKEND_DEPLOY_PATH/
                        scp bookstore-catalog.jar ubuntu@$BACKEND_VM_IP:$BACKEND_DEPLOY_PATH/

                        ssh ubuntu@$BACKEND_VM_IP <<EOF
                            sudo systemctl restart bookstore-backend.service
EOF

                        echo "Backend deployed successfully"
                    '''
                }
            }
        }

        stage('Smoke Test') {
            steps {
                script {
                    echo "Running smoke tests..."
                    sh '''
                        . jenkins/env/dev.env
                        echo "Checking backend API health..."
                        curl -f "http://$BACKEND_VM_IP:8080/actuator/health"

                        echo "Checking frontend CDN availability..."
                        curl -I "https://$CLOUDFRONT_DOMAIN" | grep HTTP

                        echo "Smoke tests passed successfully"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "CI/CD pipeline executed successfully!"
        }
        failure {
            echo "Pipeline failed. Check logs for details."
        }
    }
}