pipeline {
    agent any
    
    tools {
        jdk 'jdk11'
    }

    environment {
        // Load variables
        ENV_FILE = "jenkins/env/dev.env"
    }

    options {
        timestamps()
    }

    stages {

        stage('Checkout Source Code') {
            steps {
                script {
                    echo "Using existing workspace checkout..."
                    sh '''
                        git checkout main || git checkout master
                        git pull origin main || git pull origin master
                    '''
                    echo "Repository ready"
                }
            }
        }

        stage('Build Frontend') {
            steps {
                script {
                    echo "Building React frontend..."
                    sh '''
                        . jenkins/env/dev.env
                        cd bookstore-frontend-react-app
                        rm -rf node_modules package-lock.json build

                        export NODE_OPTIONS=--openssl-legacy-provider
                        # Point the frontend to the deployed API gateway for this environment.
                        export REACT_APP_BACKEND_API_GATEWAY_URL="http://$BACKEND_VM_IP:8765"
                        npm install --legacy-peer-deps
                        npm run build
                    '''
                }
            }
        }

        stage('Deploy Frontend (S3 + CloudFront)') {
            steps {
                script {
                    echo "Deploying frontend to S3 and invalidating CloudFront cache..."
                    sh '''
                        . jenkins/env/dev.env
                        FRONTEND_DIR="bookstore-frontend-react-app/build"

                        echo "Uploading build to S3 bucket: $S3_BUCKET"
                        aws s3 sync "$FRONTEND_DIR" "s3://$S3_BUCKET/" --delete --acl public-read

                        echo "Invalidating CloudFront cache for distribution: $CLOUDFRONT_DISTRIBUTION_ID"
                        aws cloudfront create-invalidation \
                            --distribution-id "$CLOUDFRONT_DISTRIBUTION_ID" \
                            --paths "/*"

                        echo "Frontend deployed successfully via CloudFront"
                    '''
                }
            }
        }
    }
    
    post {
        always {
            script {
                echo "Cleaning up workspace..."
                cleanWs()
            }
        }
    }
}